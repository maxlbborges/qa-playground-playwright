{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pages/*": ["./pages/*"],
      "@actions/*": ["./actions/*"],
      "@app-types": ["./types/ui.types.ts"],
      "@fixtures/*": ["./fixtures/*"]
    }
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "actions/**/*.ts",
    "pages/**/*.ts",
    "types/**/*.ts",
    "fixtures/**/*.ts"
  ],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}